# ==============================================================================
# Deen & Dunya Tracker - Environment Configuration
# ==============================================================================

# MongoDB Connection
# Set your MongoDB Atlas or local connection string:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"

# MongoDB Database Name (consistently shared across all user collections)
MONGODB_DB_NAME="deen_dunya_tracker"

# Auth.js / NextAuth Configuration
# Generate a secure 32+ character secret using: openssl rand -base64 33
AUTH_SECRET="your-generated-auth-secret-min-32-chars-long"

# Next.js Application URL (Required in production)
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# GitHub OAuth Application Credentials
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000 (or your production domain)
# - Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your_github_oauth_client_id"
AUTH_GITHUB_SECRET="your_github_oauth_client_secret"
